# OCR.Space
OCR_SPACE_API_KEY=

# Gemini
GEMINI_API_KEY=

# MySQL persistence (do not commit real credentials). Railway's MYSQL_URL can
# be referenced here directly: both mysql://... and mysql+pymysql://... work.
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/neostats_document_intelligence

# Comma-separated browser origins permitted to call the API in production.
# Example: https://your-frontend.onrender.com
CORS_ORIGINS=
